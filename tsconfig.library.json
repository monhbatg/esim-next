{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": false,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "library",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "incremental": false
  },
  "include": ["library/**/*.ts", "library/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}